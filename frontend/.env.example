# ===================================
# 🔥 FIREBASE CONFIG (Obrigatório)
# ===================================
# Obtenha em: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ===================================
# 🤖 GOOGLE GEMINI AI (Obrigatório para KakaBot e Simulado)
# ===================================
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# ☁️ CLOUDINARY (Obrigatório para upload de imagens)
# ===================================
# Obtenha em: https://cloudinary.com/
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ===================================
# NOTAS:
# ===================================
# - Nunca commite o arquivo .env real (já está no .gitignore)
# - Na Vercel, configure essas variáveis no painel de Environment Variables
# - Todas as chaves começam com VITE_ para serem expostas no frontend

